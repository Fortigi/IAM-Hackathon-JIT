# Wordt door scripts/vm-bootstrap.sh aangemaakt als compose/.env met gegenereerde secrets.
# Niet committen. Waarden met CHANGEME vul je zelf in.

DOMAIN=jit.techeddie.dev
ACME_EMAIL=CHANGEME@example.com
# Staging-CA tijdens eerste tests (geen rate limits, wel browserwaarschuwing):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

AZ_SUBSCRIPTION_ID=CHANGEME
AZ_RG=rg-jit-hackathon

# Image-versies
AUTHENTIK_TAG=2026.8.3
MP_VER=4.10.5
CORTEZA_VERSION=2024.9
TRAEFIK_TAG=v3

# authentik
AK_DB_PASS=
AK_SECRET_KEY=
AK_BOOTSTRAP_PASSWORD=
AK_BOOTSTRAP_TOKEN=
AK_ORCHESTRATOR_TOKEN=
CORTEZA_OIDC_CLIENT_SECRET=

# Gedeelde wachtwoorden voor testgebruikers en de hack-* beheerders
TEST_USER_PASSWORD=
HACK_ADMIN_PASSWORD=

# midPoint
MP_DB_PASS=
MP_ADMIN_PASSWORD=
MP_SVC_CORTEZA_PASSWORD=

# Corteza
CORTEZA_DB_PASS=

# Entra (uit seed/entra/out/entra-seed.json na seed-entra.ps1)
ENTRA_TENANT_ID=CHANGEME
ENTRA_MIDPOINT_CLIENT_ID=CHANGEME
ENTRA_MIDPOINT_CLIENT_SECRET=CHANGEME
