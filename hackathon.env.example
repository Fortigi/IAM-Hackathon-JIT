# Kopieer naar hackathon.env (staat in .gitignore) en vul aan.
# Wordt gebruikt door infra/deploy.sh en scripts/allow-my-ip.sh op je laptop.

AZ_SUBSCRIPTION_ID=eef7f73b-7588-4ef4-9f4c-dd29aff0f1b1
AZ_LOCATION=swedencentral
AZ_RG=iam-hackathon-jit-rg
PREFIX=jit

# Subdomein dat naar Azure DNS gedelegeerd wordt (NS-records in Cloudflare)
DNS_ZONE=jit.techeddie.dev

# SSH
ADMIN_USERNAME=jitadmin
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Extra IP's voor de allowlist (spatie-gescheiden, CIDR). Je eigen huidige IP
# wordt door deploy.sh automatisch toegevoegd.
EXTRA_ALLOWED_IPS=""

VM_SIZE=Standard_D8s_v5
